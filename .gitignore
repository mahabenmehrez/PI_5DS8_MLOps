# Secrets: API keys live in .env on each laptop, never in git
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
ENV/
env/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Data & Models (keep repo lightweight, download/fetch via script)
*.parquet
*.csv
!samples/*.parquet
# runtime output of the Data Checker (profiles, clean and quarantined copies)
data/checker/
mlruns/
.mlflow/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# SQLite databases & temp board files
*.db
*.db-journal
*.db-wal
*.db-shm
board.db
board.db*


# Trainer (P4): the UCI data and the reference files are small and needed by the tests
!data/winequality-red.csv
!data/winequality-white.csv
!samples/reference/*.parquet

# Trainer (P4): local runs of the long-running agent (python -m agents.trainer.fake_partners)
runs/

# Setup Agent (P1)
.setup/
agents/setup/.cache/
agents/setup/.tools/
agents/setup/logs/
agents/setup/memory/
!agents/setup/test_repos/*/data/*.csv
.env
