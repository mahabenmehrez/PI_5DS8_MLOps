"""Pandera schema of one wine batch (WineBatch), generated by the Setup Agent from {{ layout.data_path }}.

Ranges: the 0.1-99.9 percentiles of the reference data, widened by 10%, then widened again where needed so
that every reference row passes. Column names are the board's feature names; the raw CSV ("{{ plan.separator }}"
separated) uses other headers: normalize_columns() maps them.

    python {{ layout.schema_file }} <csv>      # validates a CSV file, exit code 1 on failure
"""
import sys

import pandas as pd

try:
    import pandera.pandas as pa      # pandera >= 0.24
except ImportError:                  # older pandera
    import pandera as pa

SEPARATOR = {{ plan.separator | py }}
RAW_TO_FEATURE = {
{% for c in plan.columns %}
    {{ c.raw | py }}: {{ c.name | py }},
{% endfor %}
}
FEATURES = list(RAW_TO_FEATURE.values())

WineBatch = pa.DataFrameSchema(
    {
{% for c in plan.columns %}
        {{ c.name | py }}: pa.Column({{ "int" if c.integer else "float" }}, pa.Check.in_range({{ c.low }}, {{ c.high }}), nullable=False, coerce=True),
{% endfor %}
        "wine_id": pa.Column(int, pa.Check.ge(0), nullable=False, required=False, coerce=True),
        {{ plan.target | py }}: pa.Column({{ plan.target_type }}, {{ plan.target_check }}, nullable=False, required=False, coerce=True),
    },
    strict=False,
    name="WineBatch",
)


def normalize_columns(df: pd.DataFrame) -> pd.DataFrame:
    return df.rename(columns=RAW_TO_FEATURE)


def validate(df: pd.DataFrame) -> pd.DataFrame:
    """Raises pandera SchemaErrors listing every failure (lazy validation)."""
    return WineBatch.validate(normalize_columns(df), lazy=True)


if __name__ == "__main__":
    path = sys.argv[1]
    try:
        validate(pd.read_csv(path, sep=SEPARATOR))
    except pa.errors.SchemaErrors as e:
        print(f"{path}: {len(e.failure_cases)} schema failure(s)")
        print(e.failure_cases.head(20).to_string())
        sys.exit(1)
    print(f"{path}: passes WineBatch")
